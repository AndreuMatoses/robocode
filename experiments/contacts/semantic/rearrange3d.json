   "values": {
    "clean": "No contact of the base with the furniture, and the bowl stays in place.",
    "bumps": "The base touches the furniture, or the bowl moves 2 cm or more."
   },
   "rule": "contact pairs of the robot base, and the shift of the bowl"
  }
