 "insights": [
  "There are two swing types: 18 runs throw overhand (the cube starts behind the base), and 12 runs swing forward from the front. All opus55 and opus55-source runs throw overhand; all astra-source runs swing forward.",
  "The contact view does not see the swing type (0.49); the motion view sees it (0.83). No distance sees the direction of the cube at the release.",
  "8 programs simulate candidate throws before they act. All 8 are from methods that see the simulator code.",
  "1 run (opus55 seed222) throws at an angle of 29 degrees to the room axis, so its base drives less."
 ],
 "codebook": [
  {
   "key": "swing",
   "question": "From where does the arm swing?",
   "source": "motion",
   "values": {
    "overhand": "The cube is behind the base before the swing. The arm swings up and over the top.",
    "underarm": "The cube is in front of the base, low or at middle height. The arm swings forward and up."
   },
   "rule": "overhand if the end effector is behind the base (against the throw direction) in the last slow state before the swing"
  },
  {
   "key": "arc",
   "question": "In which direction does the cube leave the gripper?",
   "source": "motion",
   "values": {
    "lob": "The cube leaves at 25 degrees or more above the horizontal: a high arc.",
    "flat": "The cube leaves between -12 and 25 degrees.",
    "downward": "The cube leaves at less than -12 degrees: thrown down from a high release point."
   },
   "rule": "elevation of the cube velocity in the first step after the release"
  },
  {
   "key": "alignment",
   "question": "Does the robot throw along the room axis?",
   "source": "motion",
   "values": {
    "straight": "The base drives to the line through the bin and throws straight along the room axis.",
    "diagonal": "The base stops before that line and throws at an angle, so it drives less."
   },
   "rule": "diagonal if the direction from the base to the bin at the release is 3 degrees or more from the room axis"
  },
  {
   "key": "standoff",
   "question": "How far from the bin does the robot throw?",
   "source": "motion",
   "values": {
    "near": "Less than 2.25 m: close to the barrier.",
    "middle": "2.25 m to 3 m.",
    "far": "More than 3 m."
   },
   "rule": "horizontal distance from the base to the bin at the release"
  },
  {
   "key": "base",
   "question": "Does the base move during the throw?",
   "source": "motion",
   "values": {
    "standing": "The base is at rest at the release.",
    "moving": "The base moves at 0.2 m/s or more at the release."
   },
   "rule": "speed of the base at the release"
  },
  {
   "key": "aim",
   "question": "How does the program select the throw?",
   "source": "program",
   "values": {
    "calibrated": "Fixed motion or a table of constants that the agent tuned in its tests (open loop).",
    "rollout": "The program has a simulator model of its own and simulates candidate throws before it acts."
   },
   "rule": "rollout if the program text has a rollout function, or a shadow or twin copy of the simulator that it steps"
  }
 ],
